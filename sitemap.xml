layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for p in site.pages %}{% assign last = p.url | slice: -1 %}{% if last != '/' %}{% continue %}{% endif %}{% if p.url == '/blog/' and site.posts.size == 0 %}{% continue %}{% endif %}<url><loc>{{ p.url | absolute_url }}</loc></url>
{% endfor %}{% for post in site.posts %}<url><loc>{{ post.url | absolute_url }}</loc><lastmod>{{ post.date | date_to_xmlschema }}</lastmod></url>
{% endfor %}</urlset>
